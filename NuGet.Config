<?xml version="1.0" encoding="utf-8"?>
<!-- Pins restore to nuget.org only. The dev machine's global NuGet config points at an
     unrelated private company feed that 401s; without this file `dotnet restore`/`build`
     fails here. Same rationale as io.m3i.ledgy. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
